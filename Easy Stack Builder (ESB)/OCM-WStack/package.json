{
  "name": "orce-esb-ocmwstack",
  "version": "12.3.7",
  "description": "ESB wrapper for the official eclipse-xfsc/deployment bootstrap procedure",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.17.0",
    "node-red": ">=3.0.0"
  },
  "node-red": {
    "nodes": {
      "ocmwstack": "ocmwstack.js"
    }
  },
  "files": [
    "ocmwstack.js",
    "ocmwstack.html",
    "lib",
    "scripts",
    "upstream-lock.json",
    "README.md",
    "CHANGELOG.md",
    "VALIDATION.md",
    "NOTICE",
    "LICENSE",
    "examples",
    "runtime",
    "charts-runtime",
    "charts-gateway",
    "docs",
    "charts-dashboards",
    "SOURCE-MANIFEST.sha256"
  ],
  "scripts": {
    "test": "node --test test/*.test.js test/runtime/*.test.cjs",
    "test:helm": "python3 test/render.py",
    "check": "node scripts/cli.js check",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "test:ui": "node --test test/ui/dom-smoke.cjs",
    "build:release": "python3 scripts/build-release.py"
  },
  "keywords": [
    "node-red",
    "xfsc",
    "esb",
    "ocm-wstack",
    "kubernetes"
  ],
  "devDependencies": {
    "vue": "3.5.13",
    "linkedom": "0.18.12"
  },
  "dependencies": {
    "bcryptjs": "2.4.3"
  }
}
