{
  "name": "orce-esb-ocmwstack",
  "version": "12.6.3",
  "description": "Node-RED deployer for OCM W-Stack and its dedicated ORCE wallet runtime",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.17.0",
    "node-red": ">=3.0.0"
  },
  "node-red": {
    "nodes": {
      "ocmwstack": "ocmwstack.js"
    }
  },
  "files": [
    "ocmwstack.js",
    "ocmwstack.html",
    "deploy.sh",
    "deployment",
    "upstream-lock.json",
    "README.md",
    "charts-runtime",
    "charts-gateway",
    "charts-dashboards",
    "pack.sh"
  ],
  "scripts": {
    "check": "bash deploy.sh check",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "keywords": [
    "node-red",
    "xfsc",
    "esb",
    "ocm-wstack",
    "kubernetes"
  ],
  "dependencies": {
    "bcryptjs": "2.4.3"
  }
}
