{
  "name": "orce-esb-ocmwstack",
  "version": "12.0.3",
  "description": "ESB wrapper for the official eclipse-xfsc/deployment bootstrap procedure",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.17.0",
    "node-red": ">=3.0.0"
  },
  "node-red": {
    "nodes": {
      "ocmwstack": "ocmwstack.js"
    }
  },
  "files": [
    "ocmwstack.js",
    "ocmwstack.html",
    "lib",
    "scripts",
    "upstream-lock.json",
    "README.md",
    "CHANGELOG.md",
    "VALIDATION.md",
