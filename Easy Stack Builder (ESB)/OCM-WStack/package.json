{
  "name": "orce-esb-ocmwstack",
  "version": "12.6.0",
  "description": "ESB wrapper for the official eclipse-xfsc/deployment bootstrap procedure",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.17.0",
    "node-red": ">=3.0.0"
  },
  "node-red": {
    "nodes": {
      "ocmwstack": "ocmwstack.js"
    }
  },
  "files": [
    "ocmwstack.js",
    "ocmwstack.html",
    "deploy.sh",
    "deployment",
    "scripts",
    "upstream-lock.json",
    "README.md",
    "CHANGELOG.md",
    "VALIDATION.md",
    "NOTICE",
    "LICENSE",
    "examples",
    "runtime",
    "charts-runtime",
    "charts-gateway",
    "docs",
    "charts-dashboards",
    "SOURCE-MANIFEST.sha256",
    "ui",
    "Dockerfile",
    ".dockerignore",
    "BUILD-STATUS.json",
    ".prettierrc.json",
    "eslint.config.mjs"
  ],
  "scripts": {
    "test": "node --test test/deployment/*.test.cjs test/runtime/*.test.cjs",
    "test:helm": "python3 test/render.py",
    "check": "bash deploy.sh check",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "test:ui": "node --test test/ui/dom-smoke.cjs",
    "build:release": "python3 scripts/build-release.py",
    "build:flows": "node scripts/build-flows.js",
    "build:ui": "npm --prefix ui run build",
    "verify:source": "node scripts/verify-source.js",
    "verify:code": "node scripts/verify-code.js",
    "format:check": "prettier --check ocmwstack.js ocmwstack.html runtime/lib runtime/nodes ui/src scripts test/runtime",
    "lint": "eslint runtime/lib runtime/nodes ui/src",
    "typecheck": "vue-tsc --noEmit -p ui/tsconfig.json",
    "test:bdd": "node --test test/bdd/*.test.cjs",
    "test:recovery": "python3 test/retrieval-recovery.py",
    "test:charts": "python3 test/all-charts.py"
  },
  "keywords": [
    "node-red",
    "xfsc",
    "esb",
    "ocm-wstack",
    "kubernetes"
  ],
  "devDependencies": {
    "vue": "3.5.13",
    "linkedom": "0.18.12",
    "prettier": "3.6.2",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.2"
  },
  "dependencies": {
    "bcryptjs": "2.4.3"
  }
}
