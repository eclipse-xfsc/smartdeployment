{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OCM-W-Stack 11 Output Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ocmUrl",
    "keycloakUrl",
    "externalIp",
    "status",
    "clientSecretRef",
    "namespace",
    "uiUrl",
    "releaseVersion",
    "runtimeVersion",
    "referenceRef",
    "referenceSha"
  ],
  "properties": {
    "ocmUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "keycloakUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "externalIp": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "degraded"
      ]
    },
    "clientSecretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name",
        "key"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "namespace": {
      "type": "string"
    },
    "uiUrl": {
      "type": "string",
      "pattern": "^https://[^/]+/orce/$"
    },
    "releaseVersion": {
      "const": "11.1.0"
    },
    "runtimeVersion": {
      "const": "11.1.0"
    },
    "referenceRef": {
      "const": "main"
    },
    "referenceSha": {
      "const": "739606691ecff72b3a40404a19fce44d9c22b0ee"
    }
  }
}
