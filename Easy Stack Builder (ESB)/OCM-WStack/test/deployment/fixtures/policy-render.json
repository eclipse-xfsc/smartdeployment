[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "policy",
      "namespace": "ocm-wstack",
      "labels": {
        "helm.sh/chart": "policy-1.1.2-helm",
        "app.kubernetes.io/name": "policy",
        "app.kubernetes.io/component": "policy-ocm-wstack",
        "app.kubernetes.io/version": "v1.4.3",
        "app.kubernetes.io/managed-by": "Helm"
      }
    },
    "spec": {
      "clusterIP": "None",
      "ports": [
        {
          "name": "http",
          "targetPort": 8080,
          "port": 8080
        }
      ],
      "selector": {
        "app.kubernetes.io/name": "policy",
        "app.kubernetes.io/component": "policy-ocm-wstack"
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "policy",
      "namespace": "ocm-wstack",
      "labels": {
        "helm.sh/chart": "policy-1.1.2-helm",
        "app.kubernetes.io/name": "policy",
        "app.kubernetes.io/component": "policy-ocm-wstack",
        "app.kubernetes.io/version": "v1.4.3",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/instance": "policy-chart",
        "app.kubernetes.io/part-of": "rse"
      }
    },
    "spec": {
      "replicas": 1,
      "strategy": {
        "type": "RollingUpdate",
        "rollingUpdate": {
          "maxSurge": 1,
          "maxUnavailable": 0
        }
      },
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "policy",
          "app.kubernetes.io/component": "policy-ocm-wstack"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "helm.sh/chart": "policy-1.1.2-helm",
            "app.kubernetes.io/name": "policy",
            "app.kubernetes.io/component": "policy-ocm-wstack",
            "app.kubernetes.io/version": "v1.4.3",
            "app.kubernetes.io/managed-by": "Helm"
          },
          "annotations": {
            "prometheus.io/scrape": "true",
            "prometheus.io/port": "2112",
            "prometheus.io/path": "/metrics",
            "inject.xfsc.io/enabled": "true",
            "inject.xfsc.io/env-prefix": "",
            "inject.xfsc.io/env-replacements": "{}",
            "inject.xfsc.io/needs": "nats,signer,did-resolver"
          }
        },
        "spec": {
          "securityContext": {
            "runAsNonRoot": false,
            "runAsGroup": 0,
            "runAsUser": 0,
            "fsGroup": 0
          },
          "containers": [
            {
              "name": "policy",
              "image": "node-654e3bca7fbeeed18f81d7c7.ps-xaas.io/tsa/policy:1.1.2",
              "imagePullPolicy": "IfNotPresent",
              "env": [
                {
                  "name": "LOG_LEVEL",
                  "value": "debug"
                },
                {
                  "name": "LOG_ENCODING",
                  "value": "json"
                },
                {
                  "name": "HTTP_HOST",
                  "value": ""
                },
                {
                  "name": "HTTP_PORT",
                  "value": "8080"
                },
                {
                  "name": "HTTP_IDLE_TIMEOUT",
                  "value": "120s"
                },
                {
                  "name": "HTTP_READ_TIMEOUT",
                  "value": "10s"
                },
                {
                  "name": "HTTP_WRITE_TIMEOUT",
                  "value": "10s"
                },
                {
                  "name": "OCM_ADDR",
                  "value": "https://demo-tenant.example.com"
                },
                {
                  "name": "TASK_ADDR",
                  "value": "http://task:8080"
                },
                {
                  "name": "CACHE_ADDR",
                  "value": "http://cache:8080"
                },
                {
                  "name": "MONGO_EXPIRATION",
                  "value": "policies"
                },
                {
                  "name": "POLICY_REPOSITORY_CLONE_URL",
                  "value": "https://github.com/eclipse-xfsc/rego-policies.git"
                },
                {
                  "name": "POLICY_REPO_FOLDER",
                  "value": "Policies"
                }
              ],
              "ports": [
                {
                  "name": "monitoring",
                  "containerPort": 2112
                },
                {
                  "name": "http",
                  "containerPort": 8080
                }
              ],
              "readinessProbe": {
                "httpGet": {
                  "path": "/readiness",
                  "port": 8080
                },
                "initialDelaySeconds": 5,
                "periodSeconds": 5,
                "successThreshold": 2,
                "failureThreshold": 2,
                "timeoutSeconds": 5
              },
              "resources": {
                "limits": {
                  "cpu": "150m",
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "25m",
                  "memory": "64Mi"
                }
              }
            }
          ]
        }
      }
    }
  }
]
