          },
          "spec": {
            "serviceAccountName": "esb-ocm-guard",
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              },
              "fsGroup": 1000
            },
            "containers": [
