                    "memory": "128Mi"
                  }
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": "http"
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": "http"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 20
                },
                "volumeMounts": [
                  {
                    "name": "source",
                    "mountPath": "/guard",
                    "readOnly": true
                  },
                  {
                    "name": "state",
                    "mountPath": "/state"
                  }
                ]
              }
            ],
            "volumes": [
