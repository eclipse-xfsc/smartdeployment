{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "host",
    "runtimeConfig"
  ],
  "properties": {
    "host": {
      "type": "string",
      "minLength": 3
    },
    "ingressClass": {
      "const": "nginx-orce-cluster"
    },
    "mongo": {
      "type": "object",
      "required": [
        "embedded"
      ],
      "properties": {
        "embedded": {
          "type": "boolean"
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "orceSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*Gi$"
        },
        "mongoSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*Gi$"
        }
      }
    }
  }
}
