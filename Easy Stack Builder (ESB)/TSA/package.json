{
  "name": "orce-esb-tsastack",
  "version": "12.1.9",
  "description": "FACIS TSA builder node with opt-in ingress changes, secure Vault token generation, service-endpoint-only health acceptance, and bounded runtime evidence persistence",
  "dependencies": {
    "tmp": "^0.2.1"
  },
  "keywords": [
    "tsa",
    "trust-service-api",
    "easy-stack-builder",
    "xfsc",
    "kubernetes",
    "helm",
    "node-red"
  ],
  "node-red": {
    "nodes": {
      "tsastack": "tsastack.js"
    }
  },
  "engines": {
    "node": ">=14.0.0",
    "node-red": ">=3.0.0"
  },
  "scripts": {
    "test": "bash test/static-validate.sh",
    "test:runtime": "bash test/runtime-health.sh",
    "test:bdd": "bash test/bdd/run-bdd.sh"
  }
